#!/bin/bash

# Commit message hook for Go MuPDF Wrapper
# Validates that commit messages follow Conventional Commits format
# https://www.conventionalcommits.org/

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get the commit message file
COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Valid commit types (Conventional Commits)
VALID_TYPES=(
    "feat"      # A new feature
    "fix"       # A bug fix
    "bugfix"    # Alternative bug fix (also accepted)
    "docs"      # Documentation only changes
    "style"     # Changes that do not affect the meaning of the code
    "refactor"  # A code change that neither fixes a bug nor adds a feature
    "perf"      # A code change that improves performance
    "test"      # Adding missing tests or correcting existing tests
    "build"     # Changes that affect the build system or external dependencies
    "ci"        # Changes to CI configuration files and scripts
    "chore"     # Other changes that don't modify src or test files
    "revert"    # Reverts a previous commit
)

# Check if commit message is empty
if [ -z "$COMMIT_MSG" ]; then
    echo -e "${RED}❌ Commit message is empty!${NC}"
    exit 1
fi

# Get the first line of the commit message (subject line)
FIRST_LINE=$(echo "$COMMIT_MSG" | head -n1)

# Check if it's a merge commit (starts with "Merge")
if echo "$FIRST_LINE" | grep -qE "^Merge "; then
    echo -e "${GREEN}✅ Merge commit detected, skipping validation${NC}"
    exit 0
fi

# Check if it's a revert commit (starts with "Revert")
if echo "$FIRST_LINE" | grep -qE "^Revert "; then
    echo -e "${GREEN}✅ Revert commit detected, skipping validation${NC}"
    exit 0
fi

# Extract the type from the commit message
# Format should be: <type>: <description>
# or: <type>(<scope>): <description>
COMMIT_TYPE=$(echo "$FIRST_LINE" | sed -E 's/^([^:\(]+).*/\1/' | sed 's/(.*//' | tr -d ' ')

# Check if commit type is valid
VALID=false
for type in "${VALID_TYPES[@]}"; do
    if [ "$COMMIT_TYPE" = "$type" ]; then
        VALID=true
        break
    fi
done

if [ "$VALID" = false ]; then
    echo -e "${RED}❌ Invalid commit message format!${NC}"
    echo ""
    echo "Commit message must start with a valid type followed by a colon:"
    echo "  <type>: <description>"
    echo ""
    echo -e "${YELLOW}Valid types:${NC}"
    for type in "${VALID_TYPES[@]}"; do
        echo "  - $type"
    done
    echo ""
    echo -e "${YELLOW}Examples:${NC}"
    echo "  feat: add new PDF creation feature"
    echo "  fix: resolve memory leak in context cleanup"
    echo "  docs: update README with installation instructions"
    echo "  refactor: simplify document loading logic"
    echo "  test: add unit tests for page extraction"
    echo ""
    echo -e "${YELLOW}Your commit message:${NC}"
    echo "  $FIRST_LINE"
    echo ""
    exit 1
fi

# Check if there's a colon after the type
if ! echo "$FIRST_LINE" | grep -qE "^${COMMIT_TYPE}:"; then
    echo -e "${RED}❌ Commit message must have a colon after the type!${NC}"
    echo ""
    echo "Format: <type>: <description>"
    echo ""
    echo -e "${YELLOW}Your commit message:${NC}"
    echo "  $FIRST_LINE"
    echo ""
    echo -e "${YELLOW}Expected format:${NC}"
    echo "  ${COMMIT_TYPE}: <description>"
    echo ""
    exit 1
fi

# Check if there's a description after the colon
DESCRIPTION=$(echo "$FIRST_LINE" | sed -E "s/^${COMMIT_TYPE}:[[:space:]]*//")
if [ -z "$DESCRIPTION" ]; then
    echo -e "${RED}❌ Commit message must have a description after the type!${NC}"
    echo ""
    echo "Format: <type>: <description>"
    echo ""
    echo -e "${YELLOW}Your commit message:${NC}"
    echo "  $FIRST_LINE"
    echo ""
    exit 1
fi

# Check if the description is too short (less than 10 characters)
if [ ${#DESCRIPTION} -lt 10 ]; then
    echo -e "${YELLOW}⚠️  Warning: Commit description is very short (${#DESCRIPTION} characters)${NC}"
    echo "  Consider adding more detail about what the commit does"
    echo ""
fi

# Check if subject line is too long (Conventional Commits recommends 72 chars)
if [ ${#FIRST_LINE} -gt 72 ]; then
    echo -e "${YELLOW}⚠️  Warning: Commit subject line is too long (${#FIRST_LINE} characters)${NC}"
    echo "  Conventional Commits recommends keeping it under 72 characters"
    echo "  Consider breaking it into multiple lines"
    echo ""
fi

# Success
echo -e "${GREEN}✅ Commit message format is valid${NC}"
echo -e "   Type: ${COMMIT_TYPE}"
echo -e "   Description: ${DESCRIPTION:0:50}$([ ${#DESCRIPTION} -gt 50 ] && echo '...')"
exit 0

