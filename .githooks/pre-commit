#!/bin/bash

# Pre-commit hook for Go MuPDF Wrapper
# Runs git-flow branch checks, linting and tests before allowing commits

# Don't use set -e, we want to track failures manually

echo "🔍 Running pre-commit checks..."

# First, check git-flow branch rules
echo ""
echo "=== Git Flow Branch Check ==="
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# Colors for branch check
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

if [ -z "$CURRENT_BRANCH" ]; then
    echo -e "${YELLOW}⚠️  Could not determine current branch, skipping branch check${NC}"
else
    echo -e "${BLUE}Current branch: ${CURRENT_BRANCH}${NC}"

    # Check if we're in the middle of a merge
    IS_MERGE=false
    MERGE_HEAD_FILE=$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)
    if [ -f "$MERGE_HEAD_FILE" ]; then
        IS_MERGE=true
        MERGE_HEAD=$(cat "$MERGE_HEAD_FILE" 2>/dev/null | head -1)
        # Try to get the branch name from the merge head
        MERGE_BRANCH=$(git name-rev --name-only "$MERGE_HEAD" 2>/dev/null | sed 's|^remotes/origin/||' | sed 's|^origin/||' || echo "unknown")
        echo -e "${BLUE}Merge in progress from: ${MERGE_BRANCH}${NC}"
    fi

    # Git-flow branch patterns
    is_main() {
        [ "$CURRENT_BRANCH" = "main" ] || [ "$CURRENT_BRANCH" = "master" ]
    }

    is_develop() {
        [ "$CURRENT_BRANCH" = "develop" ]
    }

    # Main branch protection
    if is_main; then
        if [ "$IS_MERGE" = true ]; then
            # Check if merge is from develop
            if echo "$MERGE_BRANCH" | grep -qE "(develop|origin/develop)"; then
                echo -e "${GREEN}✅ Merge from develop to main is allowed${NC}"
            else
                echo -e "${RED}❌ Main branch can only receive merges from develop!${NC}"
                echo "   Current merge is from: $MERGE_BRANCH"
                echo "   Only merges from 'develop' are allowed to main"
                exit 1
            fi
        else
            # Block direct commits to main
            echo -e "${RED}❌ Direct commits to main branch are not allowed!${NC}"
            echo ""
            echo "   Main branch should only receive merges from develop."
            echo "   Workflow:"
            echo "     1. Create a feature/bugfix branch from develop"
            echo "     2. Make commits on that branch"
            echo "     3. Merge to develop"
            echo "     4. Merge develop to main (for releases)"
            echo ""
            exit 1
        fi
    elif is_develop; then
        echo -e "${GREEN}✅ Commits to develop branch are allowed${NC}"
    else
        # Check if it's a git-flow branch
        if echo "$CURRENT_BRANCH" | grep -qE "^(feature|bugfix|hotfix|release)/"; then
            echo -e "${GREEN}✅ Commits to git-flow branch are allowed${NC}"
        else
            echo -e "${YELLOW}⚠️  Branch doesn't follow git-flow naming (feature/bugfix/hotfix/release/)${NC}"
            echo "   Allowing commit, but consider using proper git-flow branch names"
        fi
    fi
fi
echo "=============================="
echo ""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Track if any checks fail
FAILED=0

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Check code formatting with gofmt
echo "📝 Checking code formatting..."
UNFORMATTED=$(gofmt -l . 2>/dev/null | grep -v "^third_party/" || true)
if [ -n "$UNFORMATTED" ]; then
    echo -e "${RED}❌ The following files are not properly formatted:${NC}"
    echo "$UNFORMATTED"
    echo ""
    echo "Run 'gofmt -w .' to fix formatting issues"
    FAILED=1
else
    echo -e "${GREEN}✅ All files are properly formatted${NC}"
fi

# Run go vet
echo "🔍 Running go vet..."
VET_OUTPUT=$(go vet ./... 2>&1 | grep -v "^third_party/" || true)
if [ -n "$VET_OUTPUT" ]; then
    echo -e "${RED}❌ go vet found issues:${NC}"
    echo "$VET_OUTPUT"
    FAILED=1
else
    echo -e "${GREEN}✅ go vet passed${NC}"
fi

# Run golangci-lint if available
if command_exists golangci-lint; then
    echo "🔬 Running golangci-lint..."
    if golangci-lint run ./... 2>&1 | grep -v "^third_party/" | grep -q .; then
        echo -e "${YELLOW}⚠️  golangci-lint found issues (non-blocking)${NC}"
        golangci-lint run ./... 2>&1 | grep -v "^third_party/" | head -20 || true
    else
        echo -e "${GREEN}✅ golangci-lint passed${NC}"
    fi
else
    echo -e "${YELLOW}⚠️  golangci-lint not installed, skipping${NC}"
    echo "   Install with: go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest"
fi

# Check if MuPDF library is built (needed for tests)
if [ ! -f "third_party/mupdf/build/release/libmupdf.a" ]; then
    echo -e "${YELLOW}⚠️  MuPDF library not built, building now...${NC}"
    cd third_party/mupdf
    make -j$(nproc) libs >/dev/null 2>&1 || {
        echo -e "${RED}❌ Failed to build MuPDF library${NC}"
        echo "   Please build MuPDF manually: cd third_party/mupdf && make libs"
        exit 1
    }
    cd ../..
    echo -e "${GREEN}✅ MuPDF library built${NC}"
fi

# Run tests (only on changed Go files to speed up)
echo "🧪 Running tests on changed files..."

# Get list of staged Go files (exclude examples and third_party)
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' | grep -v '^third_party/' | grep -v '^examples/' || true)

if [ -z "$STAGED_GO_FILES" ]; then
    echo -e "${YELLOW}⚠️  No Go files staged (excluding examples), skipping tests${NC}"
else
    echo "   Testing files: $(echo "$STAGED_GO_FILES" | wc -l) file(s)"

    # Run tests for the package containing changed files
    # Extract unique package paths, exclude examples
    PACKAGES=$(echo "$STAGED_GO_FILES" | sed 's|/[^/]*$||' | sort -u | grep -v '^third_party/' | grep -v '^examples/' || true)

    if [ -n "$PACKAGES" ]; then
        for pkg in $PACKAGES; do
            if [ -d "$pkg" ]; then
                echo "   Testing package: $pkg"
                if go test -short "$pkg" >/dev/null 2>&1; then
                    echo -e "      ${GREEN}✅ $pkg tests passed${NC}"
                else
                    echo -e "      ${RED}❌ Tests failed in $pkg${NC}"
                    go test -short "$pkg" 2>&1 | grep -v "^third_party/" | head -10 || true
                    FAILED=1
                fi
            fi
        done
    fi

    # Also run a quick test on the main package
    if [ -d "pkg/mupdf" ]; then
        echo "   Running quick tests on pkg/mupdf..."
        if go test -short ./pkg/mupdf/ >/dev/null 2>&1; then
            echo -e "${GREEN}✅ Package tests passed${NC}"
        else
            echo -e "${RED}❌ Package tests failed${NC}"
            go test -short ./pkg/mupdf/ 2>&1 | grep -v "^third_party/" | head -20 || true
            FAILED=1
        fi
    fi
fi

# Final result
if [ $FAILED -eq 1 ]; then
    echo ""
    echo -e "${RED}❌ Pre-commit checks failed!${NC}"
    echo "   Please fix the issues above before committing."
    exit 1
else
    echo ""
    echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
    exit 0
fi

