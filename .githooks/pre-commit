#!/bin/bash

# Pre-commit hook for Go MuPDF Wrapper
# Runs git-flow branch checks, linting and tests before allowing commits

# Don't use set -e, we want to track failures manually

# If called from pre-push and pushing tags, skip merge branch checks
# This is indicated by SKIP_MERGE_CHECK environment variable set by pre-push hook
if [ "$SKIP_MERGE_CHECK" = "true" ]; then
    echo "🔍 Running pre-commit checks (skipping merge validation for tag push)..."
else
echo "🔍 Running pre-commit checks..."
fi

# First, check git-flow branch rules
echo ""
echo "=== Git Flow Branch Check ==="
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# Colors for branch check
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

if [ -z "$CURRENT_BRANCH" ]; then
    echo -e "${YELLOW}⚠️  Could not determine current branch, skipping branch check${NC}"
else
    echo -e "${BLUE}Current branch: ${CURRENT_BRANCH}${NC}"

    # Check if we're in the middle of a merge
    IS_MERGE=false
    MERGE_HEAD_FILE=$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)
    if [ -f "$MERGE_HEAD_FILE" ]; then
        IS_MERGE=true
        MERGE_HEAD=$(cat "$MERGE_HEAD_FILE" 2>/dev/null | head -1)
        # Try to get the branch name from the merge head
        MERGE_BRANCH=$(git name-rev --name-only "$MERGE_HEAD" 2>/dev/null | sed 's|^remotes/origin/||' | sed 's|^origin/||' || echo "unknown")
        echo -e "${BLUE}Merge in progress from: ${MERGE_BRANCH}${NC}"
    else
        # Check if HEAD is a merge commit (has multiple parents)
        if git rev-parse --verify 'HEAD^2' >/dev/null 2>&1; then
            IS_MERGE=true
            # Get the second parent (the merged branch)
            MERGE_HEAD=$(git rev-parse 'HEAD^2' 2>/dev/null)
            if [ -n "$MERGE_HEAD" ]; then
                MERGE_BRANCH=$(git name-rev --name-only "$MERGE_HEAD" 2>/dev/null | sed 's|^remotes/origin/||' | sed 's|^origin/||' || echo "unknown")
                echo -e "${BLUE}Merge commit detected from: ${MERGE_BRANCH}${NC}"
            fi
        fi
    fi

    # Git-flow branch patterns
    is_main() {
        [ "$CURRENT_BRANCH" = "main" ] || [ "$CURRENT_BRANCH" = "master" ]
    }

    is_develop() {
        [ "$CURRENT_BRANCH" = "develop" ]
    }

    # Main branch protection
    if is_main; then
        if [ "$SKIP_MERGE_CHECK" = "true" ]; then
            echo -e "${GREEN}✅ Skipping merge validation (tag push)${NC}"
        elif [ "$IS_MERGE" = true ]; then
            # Check if merge is from develop, release branch, hotfix branch, or tagged release
            # Also allow tags/v*^N patterns which indicate release branch merges after tagging
            if echo "$MERGE_BRANCH" | grep -qE "(develop|origin/develop|^release/|^remotes/origin/release/|^hotfix/|^remotes/origin/hotfix/|^tags/v[0-9]+\.[0-9]+\.[0-9]+\^)"; then
                echo -e "${GREEN}✅ Merge from ${MERGE_BRANCH} to main is allowed${NC}"
            else
                echo -e "${RED}❌ Main branch can only receive merges from develop, release, or hotfix branches!${NC}"
                echo "   Current merge is from: $MERGE_BRANCH"
                echo "   Only merges from 'develop', 'release/*', or 'hotfix/*' branches are allowed to main"
                exit 1
            fi
        else
            # Block direct commits to main
            echo -e "${RED}❌ Direct commits to main branch are not allowed!${NC}"
            echo ""
            echo "   Main branch should only receive merges from develop, release, or hotfix branches."
            echo "   Workflow:"
            echo "     1. Create a feature/bugfix branch from develop"
            echo "     2. Make commits on that branch"
            echo "     3. Merge to develop"
            echo "     4. Merge develop to main (for releases)"
            echo "     5. For critical fixes: hotfix/* merges to main, then back to develop"
            echo ""
            exit 1
        fi
    elif is_develop; then
        if [ "$SKIP_MERGE_CHECK" = "true" ] || [ "$SKIP_MERGE_CHECK" = "1" ]; then
            echo -e "${GREEN}✅ Skipping merge validation (tag push)${NC}"
        elif [ "$IS_MERGE" = true ]; then
            # Check if merge is from a git-flow branch (feature/bugfix/hotfix/release)
            # Also allow tags/v*^N patterns which indicate release branch merges back after tagging
            if echo "$MERGE_BRANCH" | grep -qE "^(feature|bugfix|hotfix|release)/|^tags/v[0-9]+\.[0-9]+\.[0-9]+\^"; then
                echo -e "${GREEN}✅ Merge from git-flow branch to develop is allowed${NC}"
            else
                echo -e "${RED}❌ Develop branch can only receive merges from git-flow branches!${NC}"
                echo "   Current merge is from: $MERGE_BRANCH"
                echo "   Only merges from 'feature/*', 'bugfix/*', 'hotfix/*', or 'release/*' branches are allowed to develop"
                exit 1
            fi
        else
            # Block direct commits to develop
            echo -e "${RED}❌ Direct commits to develop branch are not allowed!${NC}"
            echo ""
            echo "   Develop branch should only receive merges from feature/bugfix/hotfix/release branches."
            echo "   Workflow:"
            echo "     1. Create a feature/bugfix branch from develop"
            echo "     2. Make commits on that branch"
            echo "     3. Merge the feature/bugfix branch to develop"
            echo "     4. Merge develop to main (for releases)"
            echo ""
            exit 1
        fi
    else
        # Check if it's a git-flow branch
        if echo "$CURRENT_BRANCH" | grep -qE "^(feature|bugfix|hotfix|release)/"; then
            echo -e "${GREEN}✅ Commits to git-flow branch are allowed${NC}"
        else
            echo -e "${YELLOW}⚠️  Branch doesn't follow git-flow naming (feature/bugfix/hotfix/release/)${NC}"
            echo "   Allowing commit, but consider using proper git-flow branch names"
        fi
    fi
fi
echo "=============================="
echo ""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Track if any checks fail
FAILED=0

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Check that mupdf.lock still matches the submodule pointer. The lock file is
# part of the CI cache key for the pre-built MuPDF libraries, and a stale pin
# silently serves libraries built from the wrong MuPDF commit.
if [ -f "scripts/check-mupdf-lock.sh" ]; then
    echo "🔒 Checking mupdf.lock pin..."
    if ! bash scripts/check-mupdf-lock.sh --staged; then
        FAILED=1
    fi
fi

# Check code formatting with gofmt
echo "📝 Checking code formatting..."
UNFORMATTED=$(gofmt -l . 2>/dev/null | grep -v "^third_party/" || true)
if [ -n "$UNFORMATTED" ]; then
    echo -e "${RED}❌ The following files are not properly formatted:${NC}"
    echo "$UNFORMATTED"
    echo ""
    echo "Run 'gofmt -w .' to fix formatting issues"
    FAILED=1
else
    echo -e "${GREEN}✅ All files are properly formatted${NC}"
fi

# Run go vet (pkg/ only, matching the scope of the other checks)
echo "🔍 Running go vet..."
VET_OUTPUT=$(go vet ./pkg/... 2>&1)
VET_EXIT_CODE=$?
if [ $VET_EXIT_CODE -ne 0 ]; then
    echo -e "${RED}❌ go vet found issues:${NC}"
    echo "$VET_OUTPUT" | grep -v "^third_party/"
    FAILED=1
else
    echo -e "${GREEN}✅ go vet passed${NC}"
fi

# Run golangci-lint if available
if command_exists golangci-lint; then
    echo "🔬 Running golangci-lint..."
    LINT_OUTPUT=$(golangci-lint run ./... 2>&1 | grep -v "^third_party/" || true)
    if [ -n "$LINT_OUTPUT" ]; then
        echo -e "${YELLOW}⚠️  golangci-lint found issues (non-blocking)${NC}"
        echo "$LINT_OUTPUT" | head -20
    else
        echo -e "${GREEN}✅ golangci-lint passed${NC}"
    fi
else
    echo -e "${YELLOW}⚠️  golangci-lint not installed, skipping${NC}"
    echo "   Install with: go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest"
fi

# Check if MuPDF library is built (needed for tests)
if [ ! -f "third_party/mupdf/build/release/libmupdf.a" ]; then
    echo -e "${YELLOW}⚠️  MuPDF library not built, building now...${NC}"
    cd third_party/mupdf
    make -j$(nproc) libs USE_SYSTEM_LIBS=no HAVE_X11=no HAVE_GLUT=no build=release >/dev/null 2>&1 || {
        echo -e "${RED}❌ Failed to build MuPDF library${NC}"
        echo "   Please build MuPDF manually: cd third_party/mupdf && make libs"
        exit 1
    }
    cd ../..
    echo -e "${GREEN}✅ MuPDF library built${NC}"
fi

# Run tests (only on changed Go files to speed up)
echo "🧪 Running tests on changed files..."

# Get list of staged Go files (exclude examples and third_party)
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' | grep -v '^third_party/' | grep -v '^examples/' || true)

if [ -z "$STAGED_GO_FILES" ]; then
    echo -e "${YELLOW}⚠️  No Go files staged (excluding examples), skipping tests${NC}"
else
    echo "   Testing files: $(echo "$STAGED_GO_FILES" | wc -l) file(s)"

    # Run tests for the package containing changed files
    # Extract unique package paths, exclude examples
    PACKAGES=$(echo "$STAGED_GO_FILES" | sed 's|/[^/]*$||' | sort -u | grep -v '^third_party/' | grep -v '^examples/' || true)

    if [ -n "$PACKAGES" ]; then
        for pkg in $PACKAGES; do
            if [ -d "$pkg" ]; then
                echo "   Testing package: $pkg"
                # Capture both stdout and stderr, keeping the real exit code,
                # then filter out MuPDF warnings from the captured output
                TEST_OUTPUT=$(go test -short "$pkg" 2>&1)
                TEST_EXIT_CODE=$?
                TEST_OUTPUT=$(echo "$TEST_OUTPUT" | grep -v "^third_party/" | grep -v "syntax error:" | grep -v "warning: trying to repair" | grep -v "warning: repairing PDF" || true)

                if [ $TEST_EXIT_CODE -eq 0 ]; then
                    echo -e "      ${GREEN}✅ $pkg tests passed${NC}"
                else
                    echo -e "      ${RED}❌ Tests failed in $pkg${NC}"
                    echo "$TEST_OUTPUT" | head -20
                    FAILED=1
                fi
            fi
        done
    fi

    # Also run a quick test on the main package
    if [ -d "pkg/mupdf" ]; then
        echo "   Running quick tests on pkg/mupdf..."
        # Capture test output with the real exit code, then filter out MuPDF warnings
        TEST_OUTPUT=$(go test -short ./pkg/mupdf/ 2>&1)
        TEST_EXIT_CODE=$?
        TEST_OUTPUT=$(echo "$TEST_OUTPUT" | grep -v "^third_party/" | grep -v "syntax error:" | grep -v "warning: trying to repair" | grep -v "warning: repairing PDF" || true)

        if [ $TEST_EXIT_CODE -eq 0 ]; then
            echo -e "${GREEN}✅ Package tests passed${NC}"
        else
            echo -e "${RED}❌ Package tests failed${NC}"
            echo "$TEST_OUTPUT" | head -20
            FAILED=1
        fi
    fi
fi

# Final result
if [ $FAILED -eq 1 ]; then
    echo ""
    echo -e "${RED}❌ Pre-commit checks failed!${NC}"
    echo "   Please fix the issues above before committing."
    exit 1
else
    echo ""
    echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
    exit 0
fi

