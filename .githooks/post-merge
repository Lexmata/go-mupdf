#!/bin/bash

# Post-merge hook for automated versioning
# Creates git tags when release/X.Y.Z or hotfix/X.Y.Z branches are merged to main
# Note: VERSION file is updated by prepare-commit-msg hook as part of the merge commit

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get current branch
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# Only run on main branch
if [ "$CURRENT_BRANCH" != "main" ] && [ "$CURRENT_BRANCH" != "master" ]; then
    exit 0
fi

echo -e "${BLUE}🔍 Checking for release merge...${NC}"

# Check if this is actually a merge commit (merge commits have a second parent)
if ! git rev-parse -q --verify HEAD^2 >/dev/null 2>&1; then
    # Not a merge, just a regular commit
    exit 0
fi

# Primary detection: extract the release/hotfix branch name from the last
# merge commit message
RELEASE_BRANCH=""
LAST_MERGE=$(git log --merges -1 --format="%B" 2>/dev/null)
if echo "$LAST_MERGE" | grep -qE "(release|hotfix)/"; then
    RELEASE_BRANCH=$(echo "$LAST_MERGE" | grep -oE "(release|hotfix)/[0-9]+\.[0-9]+\.[0-9]+" | head -1)
fi

# Fallback: resolve the merged parent's name via name-rev
if [ -z "$RELEASE_BRANCH" ]; then
    MERGED_REF=$(git rev-parse HEAD^2 2>/dev/null)
    if [ -n "$MERGED_REF" ]; then
        BRANCH_NAME=$(git name-rev --name-only "$MERGED_REF" 2>/dev/null | sed 's|^remotes/origin/||' | sed 's|^origin/||')
        if echo "$BRANCH_NAME" | grep -qE "^(release|hotfix)/[0-9]+\.[0-9]+\.[0-9]+"; then
            RELEASE_BRANCH="$BRANCH_NAME"
        fi
    fi
fi

# Extract version from branch name (release/X.Y.Z or hotfix/X.Y.Z[-suffix] -> X.Y.Z)
if [ -n "$RELEASE_BRANCH" ]; then
    VERSION=$(echo "$RELEASE_BRANCH" | sed -E 's,^(release|hotfix)/([0-9]+\.[0-9]+\.[0-9]+).*,\2,')

        if [[ $VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo -e "${GREEN}✅ Release/hotfix branch detected: $RELEASE_BRANCH${NC}"
        echo -e "${BLUE}📦 Version: $VERSION${NC}"

        # Read current version from VERSION file (should be updated by prepare-commit-msg)
        CURRENT_VERSION=$(cat VERSION 2>/dev/null || echo "0.0.0")

        echo -e "${BLUE}📄 Current VERSION file: $CURRENT_VERSION${NC}"

        # Check if tag already exists
        if git rev-parse "v$VERSION" >/dev/null 2>&1; then
            echo -e "${YELLOW}⚠️  Tag v$VERSION already exists, skipping tag creation${NC}"
        else
            echo -e "${BLUE}🏷️  Creating git tag v$VERSION${NC}"

            # Create annotated tag pointing to the merge commit
            git tag -a "v$VERSION" -m "Release v$VERSION

Automated release from merge of $RELEASE_BRANCH to main.

This tag was automatically created by the post-merge hook.
Version updated to $VERSION in merge commit." 2>/dev/null || {
                echo -e "${RED}❌ Failed to create tag v$VERSION${NC}"
            }

            if git rev-parse "v$VERSION" >/dev/null 2>&1; then
                echo -e "${GREEN}✅ Tag v$VERSION created successfully${NC}"
                echo -e "${YELLOW}📝 Note: You may need to push the tag:${NC}"
                echo -e "   git push origin v$VERSION"
            fi
        fi

        # Check if tag needs to be pushed
        # (ls-remote exits 0 even when the tag is absent, so test its output)
        if git rev-parse "v$VERSION" >/dev/null 2>&1; then
            if [ -z "$(git ls-remote --tags origin "v$VERSION" 2>/dev/null)" ]; then
                echo -e "${YELLOW}📤 Tag v$VERSION created locally but not pushed${NC}"
                echo -e "   Push with: git push origin v$VERSION"
            fi
        fi
    else
        echo -e "${YELLOW}⚠️  Could not extract valid version from branch: $RELEASE_BRANCH${NC}"
    fi
else
    # Not a release/hotfix merge, exit silently
    exit 0
fi

exit 0

