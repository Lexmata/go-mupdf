#!/bin/bash

# Pre-push hook for Go MuPDF Wrapper
# Ensures all pre-commit checks pass before allowing push
# This prevents pushing code that fails quality checks

echo "🔍 Running pre-push checks..."

# Check if we're pushing tags (refs/tags/*) instead of branches or deleting refs
# Read stdin to get what's being pushed
while read local_ref local_sha remote_ref remote_sha; do
    # Check if deleting (local_sha is all zeros)
    if [[ "$local_sha" =~ ^0+$ ]]; then
        # Deleting a ref, skip all checks
        echo "🗑️  Deleting ref, skipping checks..."
        exit 0
    fi
    if [[ "$remote_ref" =~ ^refs/tags/ ]]; then
        # Pushing a tag, set flag to skip merge validation
        export SKIP_MERGE_CHECK=true
        break
    fi
done

# Get the path to the pre-commit hook
PRE_COMMIT_HOOK="$(git rev-parse --git-path hooks/pre-commit)"

# Run pre-commit checks
if [ -f "$PRE_COMMIT_HOOK" ]; then
    if ! "$PRE_COMMIT_HOOK"; then
        echo ""
        echo -e "\033[0;31m❌ Pre-push checks failed! Push blocked.\033[0m"
        echo "   All pre-commit checks must pass before pushing."
        echo "   Please fix the issues and try again."
        echo "   NEVER use --no-verify to bypass hooks."
        exit 1
    fi
else
    echo -e "\033[1;33m⚠️  Pre-commit hook not found, skipping checks\033[0m"
fi

echo ""
echo -e "\033[0;32m✅ All pre-push checks passed!\033[0m"
exit 0

