# Test Dockerfile for CI/CD simulation
# This Dockerfile creates an environment identical to the CI/CD pipeline
# for local testing and debugging.

FROM golang:1.24

# Install build dependencies for MuPDF
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libfreetype6-dev \
    libjpeg-dev \
    libpng-dev \
    zlib1g-dev \
    libjbig2dec-dev \
    libopenjp2-7-dev \
    libharfbuzz-dev \
    unzip \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace

# Set up Go environment
ENV GO111MODULE=on \
    CGO_ENABLED=1 \
    GOOS=linux \
    GOARCH=amd64 \
    GOTOOLCHAIN=auto

# Copy go.mod and go.sum first for better caching
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy the rest of the source code
COPY . .

# Configure git for submodule operations
RUN git config --global --add safe.directory /workspace

# Initialize and build MuPDF from source
RUN git submodule update --init --recursive || echo "Submodule init failed, will be handled by build.go"
RUN if [ -d "third_party/mupdf" ]; then \
        echo "Building MuPDF from source..." && \
        cd third_party/mupdf && \
        make -j$(nproc) libs && \
        cd ../.. && \
        echo "MuPDF build complete. Verifying libraries..." && \
        ls -la third_party/mupdf/build/release/*.a; \
    fi

# Default command runs all tests
CMD ["go", "test", "-v", "-race", "-coverprofile=coverage.out", "./pkg/mupdf/"]

