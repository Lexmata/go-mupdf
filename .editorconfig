# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go files
[*.go]
indent_style = tab
indent_size = 4
tab_width = 4

# Markdown files
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Shell scripts
[*.{sh,bash}]
indent_style = tab
indent_size = 2
tab_width = 2

# Makefile
[Makefile]
indent_style = tab
indent_size = 4

# Configuration files
[*.{ini,conf,config}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# XML files
[*.xml]
indent_style = space
indent_size = 2

# C/C++ files (for MuPDF)
[*.{c,cpp,h,hpp}]
indent_style = tab
indent_size = 4
tab_width = 4

# Git commit messages
[COMMIT_EDITMSG]
trim_trailing_whitespace = false

